{
  "name": "rizzmaster-voice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "android:add": "cap add android && node scripts/configure-android.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/configure-android.mjs",
    "android:open": "cap open android",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "@supabase/supabase-js": "2.97.0",
    "cordova-plugin-purchase": "13.18.0",
    "google-auth-library": "10.6.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "22.13.10",
    "@electric-sql/pglite": "0.3.14",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
